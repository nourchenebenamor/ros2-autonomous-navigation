<?xml version="1.0"?>
<robot name="tp3_robot">
  <!-- ROS coordinate convention: +X forward, +Y left, +Z up. -->
  <material name="blue"><color rgba="0.15 0.30 0.85 1"/></material>
  <material name="red"><color rgba="0.85 0.15 0.15 1"/></material>
  <material name="green"><color rgba="0.15 0.85 0.20 1"/></material>
  <material name="yellow"><color rgba="0.95 0.85 0.10 1"/></material>

  <!-- 2m x 1m body, centre is base_link. -->
  <link name="base_link">
    <visual><geometry><box size="2.0 1.0 0.5"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="2.0 1.0 0.5"/></geometry></collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.104166667" ixy="0" ixz="0" iyy="0.354166667" iyz="0" izz="0.416666667"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual><geometry><cylinder radius="0.4" length="0.2"/></geometry><material name="green"/></visual>
    <collision><geometry><cylinder radius="0.4" length="0.2"/></geometry></collision>
    <inertial><mass value="0.5"/>
      <inertia ixx="0.021666667" ixy="0" ixz="0" iyy="0.021666667" iyz="0" izz="0.04"/>
    </inertial>
  </link>
  <joint name="base_to_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="-0.5 0.6 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel_link">
    <visual><geometry><cylinder radius="0.4" length="0.2"/></geometry><material name="red"/></visual>
    <collision><geometry><cylinder radius="0.4" length="0.2"/></geometry></collision>
    <inertial><mass value="0.5"/>
      <inertia ixx="0.021666667" ixy="0" ixz="0" iyy="0.021666667" iyz="0" izz="0.04"/>
    </inertial>
  </link>
  <joint name="base_to_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="-0.5 -0.6 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster_wheel_link">
    <visual><geometry><sphere radius="0.2"/></geometry><material name="yellow"/></visual>
    <collision><geometry><sphere radius="0.2"/></geometry></collision>
    <inertial><mass value="0.05"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
  </link>
  <joint name="base_to_caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_wheel_link"/>
    <origin xyz="0.8 0 -0.2" rpy="0 0 0"/>
  </joint>

  <!-- Make the fixed spherical caster slide with very low friction. -->
  <gazebo reference="caster_wheel_link">
    <mu1>0.001</mu1><mu2>0.001</mu2>
  </gazebo>

  <!-- Gazebo differential drive. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>base_to_left_wheel_joint</left_joint>
      <right_joint>base_to_right_wheel_joint</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.4</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/tp3_robot/odometry</odom_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- LiDAR about 0.5m above base_link, safely above robot body. -->
  <gazebo reference="base_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <pose>0 0 0.50 0 0 0</pose>
      <gz_frame_id>base_link</gz_frame_id>
      <topic>/lidar</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>640</samples><resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>
        <range><min>0.08</min><max>10.0</max><resolution>0.01</resolution></range>
      </ray>
    </sensor>
  </gazebo>
</robot>
