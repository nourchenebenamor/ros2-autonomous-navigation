<?xml version="1.0"?>

<!-- This file contains the xacro description of the robot considered in the TP4 -->


<robot name="tp4_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- include the xacro properties and macros file -->
    <xacro:include filename="tp4_properties_and_macros.xacro" />

    <!-- The robot is a differential robot with a body, two controled wheels and two castor wheels for stability -->

    <!-- Note that the several origin coordinates (link and joints) are done regarding the 3D STL files (the solidworks modelisation of the robot done by Franck Mercier - Polytech Angers)-->
    <link name="dummy_root_link">
    <!-- To avoid the warning : [robot_state_publisher-1] [WARN] [1710752515.708077000] [kdl_parser]: The root link base_link has an inertia specified in the URDF, but KDL does not support a root link with an inertia.  As a workaround, you can add an extra dummy link to your URDF. -->
   </link>
    <link name="base_link">
        <xacro:cylinder_inertia mass="${body_mass}" radius="${body_radius}" height="${body_height}">
        </xacro:cylinder_inertia>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find tp4_description)/meshes/base_link.STL"/>
            </geometry> 
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${body_radius}" length="${body_height}"/>
            </geometry>
        </collision>
    </link>

  <joint name="dummy_root_joint" type="fixed">
     <parent link="dummy_root_link"/>
     <child link="base_link"/>
   </joint>

    <link name="left_wheel_link">
        <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" height="${wheel_length}">
        </xacro:cylinder_inertia>
        <visual>
            <origin xyz="0 -0.033 -0.048" rpy="${pi/2} 0 0" />
            <geometry>
                <mesh filename="file://$(find tp4_description)/meshes/left_wheel.STL"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
        </collision>
    </link>

    <link name="right_wheel_link">
        <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" height="${wheel_length}">
        </xacro:cylinder_inertia>
        <visual>
            <origin xyz="0 -0.033 0.048" rpy="${pi/2} 0 0" />
            <geometry>
                <mesh filename="file://$(find tp4_description)/meshes/right_wheel.STL"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
        </collision>
    </link>

    <link name="back_caster_wheel_link">
        <xacro:zero_inertia/>
        <xacro:visual_collision name="back_caster_wheel_link" material="yellow">
            <sphere radius="${caster_wheel_radius}"/>
        </xacro:visual_collision>
    </link>

    <link name="front_caster_wheel_link">
        <xacro:zero_inertia/>
        <xacro:visual_collision name="front_caster_wheel_link" material="cyan">
            <sphere radius="${caster_wheel_radius}"/>
        </xacro:visual_collision>
    </link>

    <joint name="base_to_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 ${body_radius+wheel_offset} -0.034" rpy="-${pi/2.0} 0 0"/>
    </joint>

    <joint name="base_to_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 ${-body_radius-wheel_offset} -0.034" rpy="-${pi/2.0} 0 0"/>
    </joint>

    <joint name="base_to_back_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_caster_wheel_link"/>
        <origin xyz="-0.029 0 -0.048" rpy="0 0 0"/>
    </joint>

    <joint name="base_to_front_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_caster_wheel_link"/>
        <origin xyz="0.029 0 -0.048" rpy="0 0 0"/>
    </joint>


    <!-- adding gazebo tags for the simulation-->

    <!-- caster wheel friction -->
    <gazebo reference="back_caster_wheel_link">
        <kp>10000000.0</kp>
        <kd>10.0</kd>
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <fdir1>1 0 0</fdir1>
        <maxVel>1.0</maxVel>
        <minDepth>0.00</minDepth>
    </gazebo>

    <gazebo reference="front_caster_wheel_link">
        <kp>10000000.0</kp>
        <kd>10.0</kd>
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <fdir1>1 0 0</fdir1>
        <maxVel>1.0</maxVel>
        <minDepth>0.00</minDepth>
    </gazebo>


    <gazebo>
        <!-- adding gazebo plugin to publish the joint state (to be displayed on rviz)-->
        <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system"/>

        <!-- adding gazebo plugin control the robot with a differential controller -->
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>base_to_left_wheel_joint</left_joint>
            <right_joint>base_to_right_wheel_joint</right_joint>
            <wheel_separation>${2*(body_radius+wheel_offset)}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <odom_publish_frequency>10</odom_publish_frequency>
            <odom_topic>odom</odom_topic>
            <enable_odom_tf>true</enable_odom_tf>
            <topic>cmd_vel</topic>
            <max_linear_acceleration>1</max_linear_acceleration>
            <min_linear_acceleration>-1</min_linear_acceleration>
            <max_angular_acceleration>2</max_angular_acceleration>
            <min_angular_acceleration>-2</min_angular_acceleration>
            <max_linear_velocity>0.5</max_linear_velocity>
            <min_linear_velocity>-0.5</min_linear_velocity>
            <max_angular_velocity>1</max_angular_velocity>
            <min_angular_velocity>-1</min_angular_velocity>
        </plugin>


      <plugin
        filename="gz-sim-pose-publisher-system"
        name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
      </plugin>

        <!-- Publish robot state information (will be used as groupe truth) -->
        <!-- <plugin filename="libgazebo-sim-pose-publisher-system.so"
        name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
            <static_update_frequency>1</static_update_frequency>
        </plugin> -->
    </gazebo>

    <gazebo reference="base_link">
        <!-- The LiDAR sensor configuration -->
        <sensor name='lidar' type='gpu_lidar'>
            <!-- Pose of the LiDAR according to the base link -->
            <pose relative_to='base_link'>0 0 ${body_height/2.0+0.01} 0 0 0</pose>
            <!-- Define the frame id for the LiDAR data (same as the robot's frame) -->
            <gz_frame_id>base_link</gz_frame_id>
            <!-- topic name for the LiDAR data -->
            <topic>lidar</topic>
            <!-- publishing rate of the data (in Hz) -->
            <update_rate>10</update_rate>
            <!-- ray configuration (360° plane LiDAR)-->
            <lidar>
                <scan>
                    <horizontal>
                        <!--<samples>320</samples>-->
                        <samples>160</samples>
                        <resolution>1</resolution>
                        <min_angle>-${2*pi/3}</min_angle>
                        <max_angle>${2*pi/3}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>0.01</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.01</min>
                    <max>3.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>
</robot>    